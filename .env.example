# Create a private local POSTGRES_PASSWORD before starting Compose.
# Use a URL-safe value; do not change it for an existing database without rotating
# the actual PostgreSQL role password. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-private-url-safe-value
DATABASE_URL=postgresql+psycopg://preflight:change-this-local-password@postgres/preflight
REDIS_URL=redis://redis:6379/0
PREFLIGHT_EXECUTION=trusted-demo
PREFLIGHT_SANDBOX_IMAGE=preflight-sandbox:0.1.0
PREFLIGHT_COOKIE_SECURE=false
# Never expose the demo deployment directly to the Internet. Use TLS and set cookie secure true.

# Optional metadata-only trace export; logs rotate at 2 MiB with two backups.
# PREFLIGHT_TRACE_FILE=.local/telemetry.jsonl
# Set a private PREFLIGHT_METRICS_TOKEN when enabling the monitoring overlay.
